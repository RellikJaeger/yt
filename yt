#!/bin/bash

yt_version="version: v0.2.10, date: Tue September 11, 2026"

# Supported browsers for extracting cookies
BROWSERS=(firefox chrome brave edge vivaldi)

YT_COMMON_OPTS=(
    --no-mtime
    --no-update
)

# Function to display the version information
show_version() {
    echo ""
    echo "   yt $yt_version"
    echo ""
}

# Function to display the help information
show_help() {
    echo '----------------+-------------------------+-----------------------------------'
    echo ' Commands       | Alias                   | Description'
    echo '----------------+-------------------------+-----------------------------------'
    echo ' yt "<URL>"     | 1080 "<URL>"            | Download best mp4 (1080p to lower)'
    echo ' yt 1080 "<URL>"|                         | Download 1080p mp4'
    echo ' yt 720 "<URL>" |                         | Download 720p mp4'
    echo ' yt 480 "<URL>" |                         | Download 480p mp4'
    echo ' yt 360 "<URL>" |                         | Download 360p mp4'
    echo ' yt 240 "<URL>" |                         | Download 240p mp4'
    echo ' yt mp3 "<URL>" |                         | Download best mp3'
    echo ' yt help        | -h, --help              | To see this help page'
    echo ' yt version     | -v, -version, --version | Check yt version'
    echo ' yt upgrade     | -u, up                  | Upgrade yt (self-reinstallation)'
    echo '----------------+-------------------------+-----------------------------------'
}

run_ytdlp() {
    local mode="$1"
    local format="$2"
    shift 2
    local urls=("$@")

    for url in "${urls[@]}"; do
        local success=false

        for browser in "${BROWSERS[@]}"; do
            if [ "$mode" = "audio" ]; then
                yt-dlp "${YT_COMMON_OPTS[@]}" \
                    --cookies-from-browser "$browser" \
                    --extract-audio \
                    --audio-format mp3 \
                    -o "%(title)s.%(ext)s" \
                    "$url"
            else
                yt-dlp "${YT_COMMON_OPTS[@]}" \
                    --cookies-from-browser "$browser" \
                    -f "$format" \
                    -o "%(title)s.%(ext)s" \
                    "$url"
            fi

            if [ $? -eq 0 ]; then
                success=true
                break
            fi
        done

        if [ "$success" = false ]; then
            echo "Failed to download $url with any available browser cookies."
        fi
    done
}

download_video() {
    local quality="$1"

    case "$quality" in
        720|480|360|240|1080|mp3)
            shift
            local urls=("$@")
            ;;
        *)
            quality="default"
            local urls=("$@")
            ;;
    esac

    if [ "$quality" != "mp3" ]; then
        mkdir -p "$HOME/Downloads/Video/"
        cd "$HOME/Downloads/Video/" || exit 1
    else
        mkdir -p "$HOME/Downloads/Music/"
        cd "$HOME/Downloads/Music/" || exit 1
    fi

    case "$quality" in
        "720")
            run_ytdlp "video" 'bv*[height<=1280][ext=mp4][vcodec^=avc1]+ba*[ext=m4a]' "${urls[@]}"
            ;;
        "480")
            run_ytdlp "video" 'bv*[height<=854][ext=mp4][vcodec^=avc1]+ba*[ext=m4a]' "${urls[@]}"
            ;;
        "360")
            run_ytdlp "video" 'bv*[height<=640][ext=mp4][vcodec^=avc1]+ba*[ext=m4a]' "${urls[@]}"
            ;;
        "240")
            run_ytdlp "video" 'bv*[height<=426][ext=mp4][vcodec^=avc1]+ba*[ext=m4a]' "${urls[@]}"
            ;;
        "mp3")
            run_ytdlp "audio" "" "${urls[@]}"
            ;;
        *)
            run_ytdlp "video" '299+140/312+234/270+234/270+234-9/301/96/96-1/95/136+140/300/bv*[height<=1920][ext=mp4][vcodec^=avc1]+ba*[ext=m4a]' "${urls[@]}"
            ;;
    esac
}

# ---------------- MAIN ----------------

if [ -z "$1" ]; then
    exit 0
fi

case "$1" in
    "-h"|"--help"|"help")
        show_help
        ;;
    "-v"|"version"|"-version"|"--version")
        show_version
        ;;
    "-u"|"up"|"upgrade")
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" && brew update && brew upgrade -y && brew install git python ffmpeg deno yt-dlp && brew cleanup --prune=all && cd "$HOME" && rm -rf "./yt/" && git clone -b macOS --depth 1 https://github.com/RellikJaeger/yt && mkdir -p "$HOME/.local/bin" && source "$HOME/.zshrc" && mv "./yt/yt" "$HOME/.local/bin/yt" && chmod a+x "$HOME/.local/bin/yt" && rm -rf "./yt/" && clear && yt -v && yt -h
        ;;
    *)
        download_video "$@"
        ;;
esac
