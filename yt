#!/bin/bash

yt_version="version: v0.2.8, date: Wed July 2, 2025"

# Function to display the version information
show_version() {
    echo ""
    echo "   yt $yt_version"
    echo ""
}

# Function to display the help information
show_help() {
    echo '----------------+-------------------------+-----------------------------------'
    echo ' Commands       | Alias                   | Description'
    echo '----------------+-------------------------+-----------------------------------'
    echo ' yt <URL>       | 1080 <URL>              | Download best mp4 (1080p to lower)'
    echo ' yt 1080 <URL>  |                         | Download 1080p mp4'
    echo ' yt 720 <URL>   |                         | Download 720p mp4'
    echo ' yt 480 <URL>   |                         | Download 480p mp4'
    echo ' yt 360 <URL>   |                         | Download 360p mp4'
    echo ' yt 240 <URL>   |                         | Download 240p mp4'
    echo ' yt mp3 <URL>   |                         | Download best mp3'
    echo ' yt help        | -h, --help              | To see this help page'
    echo ' yt version     | -v, -version, --version | Check yt version'
    echo ' yt upgrade     | -u, up                  | Upgrade yt (self-reinstallation)'
    echo '----------------+-------------------------+-----------------------------------'
}

# Function for video quality options
download_video() {
    local quality="$1"
    shift
    local URLs="$*"

    DOWNLOAD_DIR="$HOME/Downloads"
    mkdir -p "$DOWNLOAD_DIR"
    cd "$DOWNLOAD_DIR" || exit

    case "$quality" in
        "720")
            URLs="${URLs//720 /}"
            for url in $*; do
              yt-dlp -o "%(title)s.%(ext)s" -f "bv*[height<=1280][ext=mp4][vcodec^=avc1]+ba*[ext=m4a]" --no-mtime "$URLs"
            done
            ;;
        "480")
            URLs="${URLs//480 /}"
            for url in $*; do
              yt-dlp -o "%(title)s.%(ext)s" -f "bv*[height<=854][ext=mp4][vcodec^=avc1]+ba*[ext=m4a]" --no-mtime "$URLs"
            done
            ;;
        "360")
            URLs="${URLs//360 /}"
            for url in $*; do
              yt-dlp -o "%(title)s.%(ext)s" -f "bv*[height<=640][ext=mp4][vcodec^=avc1]+ba*[ext=m4a]" --no-mtime "$URLs"
            done
            ;;
        "240")
            URLs="${URLs//240 /}"
            for url in $*; do
              yt-dlp -o "%(title)s.%(ext)s" -f "bv*[height<=426][ext=mp4][vcodec^=avc1]+ba*[ext=m4a]" --no-mtime "$URLs"
            done
            ;;
        "144")
            echo "144p is not available"
            ;;
        "mp3")
            URLs="${URLs//mp3 /}"
            for url in $*; do
              yt-dlp --extract-audio --audio-format mp3 -o "%(title)s.%(ext)s" -f bestaudio[ext=m4a]/bestaudio --no-mtime "$URLs"
            done
            ;;
        *)
            URLs="${URLs//1080 /}"
            for url in $*; do
              yt-dlp -o "%(title)s.%(ext)s" -f "312+234/270+234/270+234-9/137+140/299+140/136+140/bv*[height<=1920][ext=mp4][vcodec^=avc1]+ba*[ext=m4a]/b[ext^=mp4]/b" --no-mtime "$URLs"
            done
            ;;
    esac
}

# Main script
if [ -z "$1" ]; then
    exit
fi

case "$1" in
    "-h" | "--help" | "help")
        show_help
        ;;
    "-v" | "version" | "-version" | "--version")
        show_version
        ;;
    "-u" | "up" | "upgrade")
        echo "Upgrading yt..."
        apt update && apt upgrade -y
        apt install -y git python3 python3-pip ffmpeg
        pip3 install --upgrade --force-reinstall yt-dlp
        echo "yt upgraded!"
        ;;
    *)
        download_video "$@"
        ;;
esac
