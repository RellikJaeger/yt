#!/bin/bash

yt_version="version: v0.2.9, date: Tue June 23, 2026"

# Supported browsers for extracting cookies
BROWSERS=("firefox" "chrome" "brave" "edge" "vivaldi")

YT_COMMON_OPTS=(
    --no-mtime
    --downloader aria2c
    --no-update
    --remote-components ejs:github
)

show_version() {
    echo ""
    echo "   yt $yt_version"
    echo ""
}

show_help() {
    echo '----------------+-------------------------+-----------------------------------'
    echo ' yt "<URL>"     |                         | Download best mp4 (Max 1080p)'
    echo ' yt 720 "<URL>" |                         | Download 720p mp4'
    echo ' yt 480 "<URL>" |                         | Download 480p mp4'
    echo ' yt 360 "<URL>" |                         | Download 360p mp4'
    echo ' yt mp3 "<URL>" |                         | Download mp3'
    echo ' yt help        |                         | Help'
    echo ' yt version     |                         | Version'
    echo ' yt upgrade     |                         | Upgrade'
    echo '----------------+-------------------------+-----------------------------------'
}

run_ytdlp() {
    local format="$1"
    shift
    local urls=("$@")

    for url in "${urls[@]}"; do
        echo "⏳ Processing URL: $url"
        local success=false
        
        for browser in "${BROWSERS[@]}"; do
            echo "🍪 Trying cookies from: $browser"

            if yt-dlp "${YT_COMMON_OPTS[@]}" \
                --cookies-from-browser "$browser" \
                -f "$format" \
                -o "%(title)s.%(ext)s" \
                "$url"; then
                success=true
                break # Success! Break the browser loop and move to the next URL
            fi
        done

        if [ "$success" = false ]; then
            echo "❌ Failed to download $url with any available browser cookies."
        fi
    done
}

download_video() {
    local quality="$1"
    
    # Check if the first argument is a quality flag or a direct URL
    case "$quality" in
        720|480|360|240|mp3)
            shift
            local urls=("$@")
            ;;
        *)
            # If it doesn't match a flag, it's a direct URL. Keep all arguments.
            quality="default"
            local urls=("$@")
            ;;
    esac

    # Ensure output directory exists
    mkdir -p "$HOME/Downloads/Video/"
    cd "$HOME/Downloads/Video/" || exit

    case "$quality" in
        "720")
            run_ytdlp 'bv*[height<=1280]+ba' "${urls[@]}"
            ;;
        "480")
            run_ytdlp 'bv*[height<=854]+ba' "${urls[@]}"
            ;;
        "360")
            run_ytdlp 'bv*[height<=640]+ba' "${urls[@]}"
            ;;
        "240")
            run_ytdlp 'bv*[height<=426]+ba' "${urls[@]}"
            ;;
        "mp3")
            for url in "${urls[@]}"; do
                for browser in "${BROWSERS[@]}"; do
                    if yt-dlp "${YT_COMMON_OPTS[@]}" \
                        --cookies-from-browser "$browser" \
                        --extract-audio \
                        --audio-format mp3 \
                        -o "%(title)s.%(ext)s" \
                        "$url"; then
                        break
                    fi
                done
            done
            ;;
        *)
            # Default fallback (Max 1080p)
            run_ytdlp 'bv*[height<=1920]+ba/b[height<=1920]' "${urls[@]}"
            ;;
    esac
}

# ---------------- MAIN ----------------

case "$1" in
    "-h"|"--help"|"help")
        show_help
        ;;
    "-v"|"version")
        show_version
        ;;
    "-u"|"up"|"upgrade")
        echo "🔄 Updating packages via Homebrew..."
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        brew update
        brew upgrade
        brew install git python ffmpeg aria2 deno yt-dlp
        brew cleanup

        cd "$HOME" || exit
        rm -rf "./yt/"
        git clone -b macOS --depth 1 https://github.com/RellikJaeger/yt
        mkdir -p "$HOME/.local/bin"
        mv "./yt/yt" "$HOME/.local/bin/yt"
        chmod +x "$HOME/.local/bin/yt"
        rm -rf "./yt/"

        clear
        yt -v
        yt -h
        ;;
    "")
        echo "No input provided. Try: yt help"
        ;;
    *)
        download_video "$@"
        ;;
esac
